{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "nixos_small",
    "padding": { "top": 1, "left": 1, "right": 3 },
    "color": { "1": "#89b4fa", "2": "#cba6f7", "3": "#89b4fa", "4": "#cba6f7", "5": "#89b4fa", "6": "#cba6f7" }
  },
  "display": {
    "separator": "  ",
    "key": { "width": 10 },
    "color": { "keys": "#cba6f7", "output": "#cdd6f4" }
  },
  "modules": [
    { "type": "title", "color": { "user": "#f5c2e7", "at": "#6c7086", "host": "#cba6f7" } },
    "break",
    { "type": "os", "key": "\uf313  os", "keyColor": "#89b4fa", "format": "{name} {version-id}" },
    { "type": "kernel", "key": "\uf17c  kernel", "keyColor": "#74c7ec", "format": "{release}" },
    { "type": "de", "key": "\uf108  de", "keyColor": "#94e2d5" },
    { "type": "cpu", "key": "\uf4bc  cpu", "keyColor": "#a6e3a1", "format": "{name}" },
    { "type": "gpu", "key": "\udb82\udcae  gpu", "keyColor": "#fab387", "format": "{name}" },
    { "type": "memory", "key": "\udb80\udf5b  ram", "keyColor": "#f38ba8" },
    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 2 }
  ]
}
