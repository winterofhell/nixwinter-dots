{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "~/.config/fastfetch/nixos.txt",
    "padding": {
      "right": 3
    },
    "color": {
      "1": "#cba6f7",
      "2": "#89b4fa",
      "3": "#94e2d5",
      "4": "#f5c2e7",
      "5": "#fab387",
      "6": "#a6e3a1"
    }
  },
  "display": {
    "separator": "  ",
    "key": {
      "width": 14
    },
    "color": {
      "keys": "#cba6f7",
      "title": "#f5c2e7"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name}@{host-name}"
    },
    "separator",
    {
      "type": "os",
      "key": "  OS"
    },
    {
      "type": "host",
      "key": "󰌢  Host"
    },
    {
      "type": "kernel",
      "key": "󰒋  Kernel"
    },
    {
      "type": "uptime",
      "key": "󰅐  Uptime"
    },
    {
      "type": "cpu",
      "key": "  CPU"
    },
    {
      "type": "gpu",
      "key": "󰢮  GPU"
    },
    {
      "type": "memory",
      "key": "  RAM"
    },
    {
      "type": "disk",
      "key": "󰋊  Disk"
    },
    {
      "type": "display",
      "key": "󰍹  Display"
    },
    {
      "type": "de",
      "key": "  Desktop"
    },
    {
      "type": "wm",
      "key": "󱂬  WM"
    },
    {
      "type": "terminal",
      "key": "  Terminal"
    }
  ]
}
